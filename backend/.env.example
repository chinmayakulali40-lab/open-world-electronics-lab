PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/electronics_lab?schema=public"
JWT_SECRET="electronics_lab_super_secure_jwt_secret_2026_sbh06387"
FRONTEND_URL="http://localhost:8085"
NODE_ENV="development"

# =========================================================================
# LIVE SMS GATEWAY DISPATCH SETUP
# =========================================================================
# Set SMS_PROVIDER to either 'fast2sms' or 'twilio'
SMS_PROVIDER=fast2sms

# FAST2SMS (Popular for Indian mobile numbers +91)
# Sign up at: https://www.fast2sms.com
# Get API key from: Dev API -> API Keys
FAST2SMS_API_KEY=your_key_here

# OR TWILIO (Global SMS Gateway)
# Sign up at: https://www.twilio.com
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=your_number

# =========================================================================
# EMAIL DISPATCH SETUP (Nodemailer)
# =========================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Open-World Electronics Lab <your_email@gmail.com>"
