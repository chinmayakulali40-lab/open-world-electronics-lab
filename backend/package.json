{
  "name": "open-world-electronics-lab-backend",
  "version": "1.0.0",
  "description": "Production-ready Express + TypeScript + PostgreSQL (Prisma) backend for Open-World Electronics Lab",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate && tsc",
    "start": "prisma db push && node dist/server.js",
    "dev": "ts-node src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "ts-node": "^10.9.2"
  }
}
