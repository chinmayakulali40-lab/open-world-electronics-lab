datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SharePermission {
  VIEWER
  EDITOR
}

model User {
  id            String         @id @default(uuid())
  fullName      String
  email         String         @unique
  phone         String?        @unique
  passwordHash  String
  role          Role           @default(STUDENT)
  verifiedEmail Boolean        @default(false)
  verifiedPhone Boolean        @default(false)
  createdAt     DateTime       @default(now())
  
  projects      Project[]      @relation("UserProjects")
  sharedWithMe  ProjectShare[] @relation("SharedWithUser")
}

model Project {
  id              String         @id @default(uuid())
  title           String
  description     String?
  schematicData   Json           // 2D components, node positions, wires, pin mappings
  environmentData Json?          // Sunlight, temperature, clouds, location preset
  shareCode       String         @unique @default(cuid()) // For instant link sharing
  authorId        String
  author          User           @relation("UserProjects", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  shares          ProjectShare[]
  analyticsLogs   SimulationLog[]
}

model ProjectShare {
  id          String          @id @default(uuid())
  projectId   String
  userId      String
  permission  SharePermission @default(VIEWER)
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User            @relation("SharedWithUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model SimulationLog {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runDurationSec  Int       // Time spent simulating
  componentCount  Int       // Total parts placed
  peakVoltage     Float?    // Max voltage recorded on multimeter/scope
  peakPower       Float?    // Max power recorded from solar/source
  environmentUsed String?   // "Classroom", "Farm", etc.
  completedAt     DateTime  @default(now())
}
